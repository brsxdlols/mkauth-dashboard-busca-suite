<?php
/* mka-suite-ramal-password-guard-v1 */
// Same .hhvm handler as the native editor: invalidate only our verified wrappers.
include 'configure.php';include 'conexao.php';include 'sessao_admin.hhvm';
require_once __DIR__.'/addons/shared/ramal_api_access.php';
header('Content-Type: application/json; charset=utf-8');header('Cache-Control: no-store, private');
try{
 $actor=(string)($_SESSION['MKA_Usuario']??'');
 if($actor===''||!mka_ramal_has_permission($LOADMYSQL,$actor,'perm_servidor')){http_response_code(403);echo json_encode(array('error'=>'Sem acesso a Ramais.'));exit;}
 if(mka_ramal_password_manifest(__DIR__)===null)throw new RuntimeException('Integracao pendente.');
 foreach(array('ramal_alt.hhvm','executar_ramal.hhvm')as$file){$path=__DIR__.'/'.$file;
  if(function_exists('opcache_is_script_cached')&&opcache_is_script_cached($path)&&(!function_exists('opcache_invalidate')||!opcache_invalidate($path,true)))throw new RuntimeException('Cache nativo pendente.');
 }
 echo json_encode(array('protected'=>true));
}catch(Throwable $error){http_response_code(409);echo json_encode(array('error'=>'Atualize a pagina e confira a integracao do ramal antes de gravar.'));}
